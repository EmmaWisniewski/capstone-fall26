.DS_Store

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
build/
dist/

# Data (DESIGN §15): raw cache is never committed; interim only as small samples
data/raw/
data/interim/*
!data/interim/.gitkeep

# Generated by the program (DESIGN §15): never committed. The final files and the final run's
# reports are attached to the GitHub release instead.
data/output/*
!data/output/.gitkeep
reports/*
!reports/.gitkeep

# Secrets
.env
